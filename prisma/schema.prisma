generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("CUSTOMER") // "ADMIN" | "CUSTOMER"
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orders       Order[]
  reviews      Review[]
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?   @db.NVarChar(Max)
  image       String?   @db.NVarChar(Max)
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  products    Product[]
}

model Product {
  id               String      @id @default(uuid())
  name             String
  slug             String      @unique
  description      String      @db.NVarChar(Max)
  shortDescription String?     @db.NVarChar(Max)
  price            Decimal     @db.Decimal(10, 2)
  comparePrice     Decimal?    @db.Decimal(10, 2)
  costPrice        Decimal?    @db.Decimal(10, 2)
  stock            Int         @default(10)
  sku              String?
  materials        String?     @db.NVarChar(Max)
  dimensions       String?
  weightGrams      Int?        @default(5)
  images           String      @db.NVarChar(Max) // JSON Array of image URLs
  isFeatured       Boolean     @default(false)
  isActive         Boolean     @default(true)
  categoryId       String
  category         Category    @relation(fields: [categoryId], references: [id])
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  orderItems       OrderItem[]
  reviews          Review[]
  collections      CollectionProduct[]
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique
  customerName    String
  customerEmail   String
  customerPhone   String?
  shippingAddress String      @db.NVarChar(Max)
  city            String
  postalCode      String
  province        String
  country         String      @default("ES")
  subtotal        Decimal     @db.Decimal(10, 2)
  discountAmount  Decimal?    @default(0.00) @db.Decimal(10, 2)
  couponCode      String?
  shippingCost    Decimal     @db.Decimal(10, 2)
  totalAmount     Decimal     @db.Decimal(10, 2)
  status          String      @default("PENDING") // "PENDING" | "PAID" | "PROCESSING" | "SHIPPED" | "DELIVERED" | "CANCELLED"
  paymentMethod   String      @default("PAYPAL")
  paypalOrderId   String?
  trackingNumber  String?
  notes           String?     @db.NVarChar(Max)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  userId          String?
  user            User?       @relation(fields: [userId], references: [id])
  items           OrderItem[]
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  productName  String
  productImage String?  @db.NVarChar(Max)
  unitPrice    Decimal  @db.Decimal(10, 2)
  quantity     Int      @default(1)
}

model Review {
  id              String   @id @default(uuid())
  productId       String? // null = general store review
  product         Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorName      String
  authorEmail     String
  rating          Int      @default(5)
  title           String?
  comment         String   @db.NVarChar(Max)
  isApproved      Boolean  @default(false)
  isVerifiedBuyer Boolean  @default(false)
  createdAt       DateTime @default(now())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
}

model StoreSetting {
  id                    String   @id @default(uuid())
  storeName             String   @default("Bohoart Jewelry")
  announcementText      String   @default("✨ Envíos gratis a toda España en pedidos superiores a 40€ | Joyería artesanal hecha a mano ✨")
  freeShippingThreshold Decimal  @default(40.00) @db.Decimal(10, 2)
  standardShippingCost  Decimal  @default(3.95) @db.Decimal(10, 2)
  paypalClientId        String?
  contactEmail          String   @default("hola@bohoartjoyeria.com")
  instagramUrl          String   @default("https://instagram.com/bohoart.jewelry")
  bizumPhone            String?
  paypalMeUrl           String?
  maintenanceMode       Boolean  @default(false)
  maintenanceAllowedIps String?  @db.NVarChar(Max)
  maintenanceTitle      String?  @default("✨ Estamos preparando novedades con mucho mimo ✨")
  maintenanceMessage    String?  @db.NVarChar(Max)
  updatedAt             DateTime @updatedAt
}

// Seasonal / themed landings (Feria de Albacete, Virgen del Pilar, Halloween, Navidad...)
model Collection {
  id           String              @id @default(uuid())
  name         String
  slug         String              @unique
  tagline      String?
  description  String?             @db.NVarChar(Max)
  heroImage    String?             @db.NVarChar(Max)
  accentColor  String              @default("#C2694F")
  startsAt     DateTime?
  endsAt       DateTime?
  repeatYearly Boolean             @default(false)
  isActive     Boolean             @default(true)
  showOnHome   Boolean             @default(true)
  sortOrder    Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  products     CollectionProduct[]
}

model CollectionProduct {
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sortOrder    Int        @default(0)

  @@id([collectionId, productId])
}

model Coupon {
  id             String    @id @default(uuid())
  code           String    @unique
  description    String?   @db.NVarChar(Max)
  discountType   String    @default("PERCENTAGE") // "PERCENTAGE" | "FIXED"
  discountValue  Decimal   @db.Decimal(10, 2)
  minOrderAmount Decimal?  @default(0.00) @db.Decimal(10, 2)
  maxUses        Int?
  usedCount      Int       @default(0)
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ───────────────────────── Talleres (workshops) ─────────────────────────

model Workshop {
  id               String            @id @default(uuid())
  title            String
  slug             String            @unique
  shortDescription String?
  description      String            @db.NVarChar(Max)
  price            Decimal           @db.Decimal(10, 2) // precio total por plaza
  depositType      String            @default("FIXED") // "FIXED" (importe por plaza) | "PERCENT" (% del precio)
  depositValue     Decimal           @default(20.00) @db.Decimal(10, 2) // señal: no reembolsable
  durationMinutes  Int               @default(120)
  materials        String?           @db.NVarChar(Max) // materiales incluidos (una línea por elemento)
  faq              String?           @db.NVarChar(Max) // JSON: [{ "q": "...", "a": "..." }]
  image            String?           @db.NVarChar(Max)
  isActive         Boolean           @default(true)
  sortOrder        Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sessions         WorkshopSession[]
  reviews          WorkshopReview[]
  photos           WorkshopPhoto[]
  inquiries        WorkshopInquiry[]
}

model WorkshopSession {
  id         String            @id @default(uuid())
  workshopId String
  workshop   Workshop          @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  startsAt   DateTime
  capacity   Int               @default(6)
  seatsTaken Int               @default(0) // plazas con reserva PAID/ATTENDED (se actualiza de forma atómica)
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())
  bookings   WorkshopBooking[]

  @@index([workshopId, startsAt])
}

model WorkshopBooking {
  id            String          @id @default(uuid())
  reference     String          @unique
  sessionId     String
  session       WorkshopSession @relation(fields: [sessionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customerName  String
  customerEmail String
  customerPhone String
  seats         Int             @default(1)
  totalAmount   Decimal         @db.Decimal(10, 2) // precio total del taller para las plazas reservadas
  depositAmount Decimal         @db.Decimal(10, 2) // señal a pagar online (no reembolsable)
  amountPaid    Decimal         @default(0.00) @db.Decimal(10, 2)
  paymentMethod String? // "PAYPAL" | "REDSYS"
  paymentRef    String? // id de pedido PayPal o nº de pedido Redsys
  status        String          @default("PENDING") // "PENDING" | "PAID" | "CANCELLED" | "ATTENDED"
  notes         String?         @db.NVarChar(Max)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([sessionId, status])
  @@index([paymentRef])
}

model WorkshopReview {
  id          String   @id @default(uuid())
  workshopId  String
  workshop    Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  authorName  String
  authorEmail String
  rating      Int      @default(5)
  comment     String   @db.NVarChar(Max)
  isApproved  Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model WorkshopPhoto {
  id         String   @id @default(uuid())
  workshopId String
  workshop   Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  url        String   @db.NVarChar(Max)
  caption    String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
}

// Consulta de "pedir otra fecha u horario" / contacto fuera de horario.
model WorkshopInquiry {
  id            String    @id @default(uuid())
  workshopId    String?
  workshop      Workshop? @relation(fields: [workshopId], references: [id], onDelete: SetNull)
  name          String
  email         String
  phone         String?
  preferredDate String?
  message       String    @db.NVarChar(Max)
  status        String    @default("NEW") // "NEW" | "ANSWERED" | "ARCHIVED"
  createdAt     DateTime  @default(now())
}

// Información de la sala donde se dan los talleres (una sola fila, id = "main"). Sección informativa, no reservable.
model WorkshopRoomInfo {
  id        String   @id @default("main")
  title     String   @default("Nuestra sala de talleres")
  text      String   @default("") @db.NVarChar(Max)
  photos    String   @default("[]") @db.NVarChar(Max) // JSON: string[] de URLs
  updatedAt DateTime @updatedAt
}
