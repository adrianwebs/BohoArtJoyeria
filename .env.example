# Next.js & General
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000

# Microsoft SQL Server Database Connection
# Format: sqlserver://<HOST>:<PORT>;database=<DB_NAME>;user=<USER>;password=<PASSWORD>;encrypt=true;trustServerCertificate=true
DATABASE_URL="sqlserver://localhost:1433;database=BohoartDB;user=sa;password=YourPassword123!;encrypt=true;trustServerCertificate=true"

# Authentication Secrets
# REQUIRED. Generate with: openssl rand -hex 32  (min 32 chars; the app refuses known/default values)
JWT_SECRET="CHANGE_ME_generate_with_openssl_rand_hex_32"
ADMIN_EMAIL="admin@bohoartjoyeria.com"
# REQUIRED. Choose a long unique password (the app refuses known/default values)
ADMIN_PASSWORD="CHANGE_ME_long_unique_password"

# Maintenance Mode Configuration (Override via env)
MAINTENANCE_MODE=false
MAINTENANCE_ALLOWED_IPS="127.0.0.1, ::1"

# PayPal Smart Checkout Integration
# Get sandbox client id from https://developer.paypal.com
NEXT_PUBLIC_PAYPAL_CLIENT_ID="sb"
PAYPAL_CLIENT_SECRET=""
PAYPAL_MODE="sandbox"

# PayPal server-side keys (Client ID is read at runtime by the server; secret never reaches the browser)
PAYPAL_CLIENT_ID=
# PAYPAL_MODE=sandbox | live (set above)

# Image uploads (defaults to ./public/uploads; in Docker it is the mounted volume)
# UPLOAD_DIR=

# Transactional email (optional; emails are skipped when SMTP_HOST is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Bohoart Jewelry <hola@bohoartjoyeria.com>"
ORDER_NOTIFY_EMAIL=
